# Database to back up and restore. The server never touches any other one.
DB_HOST=tracker-db
DB_PORT=5432
DB_USERNAME=tracker
DB_PASSWORD=change-me
DB_NAME=tracker

# Google service account key (JSON, one line) and the target folder id.
DRIVE_CREDS={"type":"service_account",...}
DRIVE_FOLDER_ID=change-me

# Optional.
# Keep this many regular pg_dump backups; legacy JSON and pre-restore copies are kept.
#DRIVE_RETENTION_COUNT=30
# zstd level for pg_dump, 1..22.
#COMPRESSION_LEVEL=3
#DATA_FOLDER=data
#LISTEN_ADDR=0.0.0.0:50051
#RUST_LOG=info
